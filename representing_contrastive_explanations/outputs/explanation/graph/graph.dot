digraph {
	graph [bgcolor=lightyellow fontcolor=black fontsize=20 label="Query: Parent and (hasChild some (hasParent some Parent)) | fact=F3F46 | foil=F7F118" rankdir=LR splines=true]
	subgraph cluster_fact {
		color=lightyellow fontcolor=black fontsize=16 label="" labelloc=t style=filled
		F3M45 -> Father [label=Type]
		F3M47 -> F3M45 [label=hasParent]
		F3F46 -> Grandmother [label=Type]
		F3F46 -> F3M47 [label=hasChild]
	}
	subgraph cluster_foil_common {
		color=lightyellow fontcolor=black fontsize=16 label="" labelloc=t style=filled
		F7M115 -> Father [label=Type]
		F7F118 -> F7M115 [label=hasParent]
	}
	subgraph cluster_foil_diff {
		color=lightyellow fontcolor=black fontsize=16 labelloc=t style=filled
		F7F118 -> Grandmother [label=Type color="#ff0000" penwidth=2 style=dashed]
		F7F118 -> F7F118 [label=hasChild color="#ff0000" penwidth=2 style=dashed]
	}
	F3M45 [fillcolor="#3399FF" style=filled]
	Father [fillcolor=lightyellow style=filled]
	F3M47 [fillcolor="#3399FF" style=filled]
	F3F46 [fillcolor="#3399FF" style=filled]
	Grandmother [fillcolor=lightyellow style=filled]
	F7M115 [fillcolor="#6AC780" style=filled]
	F7F118 [fillcolor="#6AC780" style=filled]
	legend [label=<
            <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
              <TR><TD COLSPAN="2"><B>Legend</B></TD></TR>
              <TR><TD BGCOLOR="#3399FF"></TD><TD>Fact node</TD></TR>
              <TR><TD BGCOLOR="#6AC780"></TD><TD>Foil node</TD></TR>
              <TR><TD BGCOLOR="lightyellow"></TD><TD>Common node</TD></TR>
              <TR><TD><FONT COLOR="#ff0000"><I>--------</I></FONT></TD><TD>Missing edge in foil</TD></TR>
            </TABLE>
        > shape=none]
}